<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PitCrew" Width="1120" Height="740" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F6F7F9"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#E10600"/>
    <SolidColorBrush x:Key="Ink" Color="#1B1F24"/>
    <SolidColorBrush x:Key="Muted" Color="#5F6773"/>
    <SolidColorBrush x:Key="Line" Color="#E3E6EA"/>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource Accent}"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#E9ECF0"/>
    </Style>

    <Style x:Key="NavItem" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#C9CED6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bg" Background="Transparent" Padding="18,10" Margin="8,2" CornerRadius="6">
              <Grid>
                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="-12,0,0,0" Background="{StaticResource Accent}" Visibility="Collapsed" CornerRadius="2"/>
                <ContentPresenter/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#1F2228"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#262A31"/>
                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="8,2"/>
      <Setter Property="Margin" Value="6,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <DataTemplate x:Key="ItemCard">
      <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <CheckBox x:Name="Pick" Grid.Column="0" VerticalAlignment="Top" Margin="0,3,12,0"
                    IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"/>
          <StackPanel Grid.Column="1">
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
              <Border x:Name="BadgePill" DockPanel.Dock="Left" Style="{StaticResource Pill}" Background="#EEF0F3">
                <TextBlock x:Name="BadgeText" Text="{Binding Badge}" FontSize="11" Foreground="#4A5160"/>
              </Border>
              <Border x:Name="TagPill" DockPanel.Dock="Left" Style="{StaticResource Pill}" Background="#EEF0F3">
                <TextBlock x:Name="TagText" Text="{Binding Tag}" FontSize="11" Foreground="#4A5160"/>
              </Border>
            </DockPanel>
            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <DockPanel x:Name="MetaRow" LastChildFill="False" Margin="0,4,0,0">
              <TextBlock DockPanel.Dock="Left" Text="{Binding Meta}" FontSize="11.5" Foreground="#8A919C"/>
              <TextBlock x:Name="LinkBlock" DockPanel.Dock="Left" FontSize="11.5" Margin="10,0,0,0">
                <Hyperlink NavigateUri="{Binding Link}" Foreground="#0B62D6"><Run Text="{Binding LinkText}"/></Hyperlink>
              </TextBlock>
            </DockPanel>
          </StackPanel>
        </Grid>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding BadgeKind}" Value="good">
          <Setter TargetName="BadgePill" Property="Background" Value="#E7F6EC"/>
          <Setter TargetName="BadgeText" Property="Foreground" Value="#1E7B3A"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="warn">
          <Setter TargetName="BadgePill" Property="Background" Value="#FFF4E0"/>
          <Setter TargetName="BadgeText" Property="Foreground" Value="#9A5B00"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding BadgeKind}" Value="bad">
          <Setter TargetName="BadgePill" Property="Background" Value="#FDECEC"/>
          <Setter TargetName="BadgeText" Property="Foreground" Value="#B42318"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TagKind}" Value="warn">
          <Setter TargetName="TagPill" Property="Background" Value="#FFF4E0"/>
          <Setter TargetName="TagText" Property="Foreground" Value="#9A5B00"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding TagKind}" Value="bad">
          <Setter TargetName="TagPill" Property="Background" Value="#FDECEC"/>
          <Setter TargetName="TagText" Property="Foreground" Value="#B42318"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Badge}" Value="">
          <Setter TargetName="BadgePill" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Tag}" Value="">
          <Setter TargetName="TagPill" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Link}" Value="{x:Null}">
          <Setter TargetName="LinkBlock" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Meta}" Value="">
          <Setter TargetName="LinkBlock" Property="Margin" Value="0"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Selectable}" Value="False">
          <Setter TargetName="Pick" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <MultiDataTrigger>
          <MultiDataTrigger.Conditions>
            <Condition Binding="{Binding Meta}" Value=""/>
            <Condition Binding="{Binding Link}" Value="{x:Null}"/>
          </MultiDataTrigger.Conditions>
          <Setter TargetName="MetaRow" Property="Visibility" Value="Collapsed"/>
        </MultiDataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="230"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Navigation -->
    <Border Grid.Column="0" Background="#15171C">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="22,24,22,18">
          <StackPanel Orientation="Horizontal">
            <Border Width="10" Height="22" Background="{StaticResource Accent}" CornerRadius="2" Margin="0,0,10,0"/>
            <TextBlock Text="PitCrew" FontSize="22" FontWeight="Bold" Foreground="White"/>
          </StackPanel>
          <TextBlock x:Name="Tagline" Foreground="#8A919C" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="22,12,22,20">
          <TextBlock x:Name="ModeText" Foreground="#8A919C" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <ComboBox x:Name="LanguageBox"/>
        </StackPanel>
        <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontSize="14">
          <ListBoxItem x:Name="NavPerformance" Tag="performance"/>
          <ListBoxItem x:Name="NavPrivacy" Tag="privacy"/>
          <ListBoxItem x:Name="NavExplorer" Tag="explorer"/>
          <ListBoxItem x:Name="NavStartup" Tag="startup"/>
          <ListBoxItem x:Name="NavCleanup" Tag="cleanup"/>
          <ListBoxItem x:Name="NavMaintenance" Tag="maintenance"/>
          <ListBoxItem x:Name="NavApps" Tag="apps"/>
          <ListBoxItem x:Name="NavDrivers" Tag="drivers"/>
          <ListBoxItem x:Name="NavRestore" Tag="restore"/>
          <ListBoxItem x:Name="NavHistory" Tag="history"/>
          <ListBoxItem x:Name="NavAbout" Tag="about"/>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Margin="32,26,32,10">
        <TextBlock x:Name="PageTitle" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
        <TextBlock x:Name="PageIntro" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>

      <Border x:Name="Banner" Grid.Row="1" Margin="32,0,32,10" Padding="12,8" CornerRadius="6"
              Background="#FFF4E0" BorderBrush="#F2D29B" BorderThickness="1" Visibility="Collapsed">
        <TextBlock x:Name="BannerText" Foreground="#7A4800" TextWrapping="Wrap"/>
      </Border>

      <Grid Grid.Row="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Search, filter, presets and profile: shown on long list pages only -->
        <DockPanel x:Name="FilterBar" Grid.Row="0" Margin="32,0,32,10" LastChildFill="False" Visibility="Collapsed">
          <Grid DockPanel.Dock="Left" Width="250">
            <TextBox x:Name="SearchBox" Padding="8,5" VerticalContentAlignment="Center" BorderBrush="{StaticResource Line}"/>
            <TextBlock x:Name="SearchHint" Margin="11,0,0,0" VerticalAlignment="Center" Foreground="#8A919C" IsHitTestVisible="False"/>
          </Grid>
          <CheckBox x:Name="HideUnavailable" DockPanel.Dock="Left" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
          <Button x:Name="ExportProfile" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,6"/>
          <ComboBox x:Name="PresetBox" DockPanel.Dock="Right" Width="200" Margin="14,0,0,0" VerticalContentAlignment="Center" Padding="8,5"/>
        </DockPanel>
        <ScrollViewer Grid.Row="1" x:Name="ListScroll" Padding="32,4,32,8" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="PageInfo" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="Collapsed"/>
            <ItemsControl x:Name="Items" ItemTemplate="{StaticResource ItemCard}"/>
            <TextBlock x:Name="EmptyText" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="32,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="SecondaryAction" Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="PrimaryAction" Style="{StaticResource PrimaryButton}"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ProgressBar x:Name="Busy" Width="90" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,10,0" Foreground="{StaticResource Accent}"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="520"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
