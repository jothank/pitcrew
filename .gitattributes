* text=auto
# cmd.exe misreads batch files with LF-only line endings
*.bat text eol=crlf
*.ps1 text eol=crlf
*.xaml text eol=crlf
*.png binary
*.ico binary
*.cs text eol=crlf
*.manifest text eol=crlf
# Not needed inside the release zip
.gitattributes export-ignore
.gitignore export-ignore
# Future CI files stay in the repository, not in the release zip
/.github export-ignore
