# Runtime data normally lives in %ProgramData%\PitCrew; these catch anything written next to the code
logs/
reports/
driver-backups/
*.log

# The original stand-alone driver script this project grew from (now src/Modules/Drivers.ps1)
/atualizar-drivers/

# Local renders and scratch files
/screenshots-local/
*.tmp

# Local state of the oh-my-claudecode agent tooling
.omc/

# Editors
.vscode/
.idea/
*.swp

# Release builds (tools\Build-Release.ps1)
/dist/

# Never part of a release: a built launcher at the root, signing keys, local secrets and agent settings
/PitCrew.exe
*.pfx
*.p12
*.snk
.env
.claude/settings.local.json
